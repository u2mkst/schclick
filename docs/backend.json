
{
  "entities": {
    "School": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "School",
      "type": "object",
      "description": "Represents a school participating in the 'School Click' application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number" },
        "daebakScore": { "type": "number" },
        "cityProvinceName": { "type": "string" },
        "schoolKind": { "type": "string" },
        "atptCode": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name", "score", "cityProvinceName", "schoolKind"]
    },
    "Ban": {
      "title": "Ban",
      "type": "object",
      "description": "Represents a banned IP address due to suspicious activity.",
      "properties": {
        "ip": { "type": "string" },
        "reason": { "type": "string" },
        "bannedAt": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["ip", "bannedAt"]
    },
    "DeviceBan": {
      "title": "DeviceBan",
      "type": "object",
      "description": "Represents a banned browser/device ID.",
      "properties": {
        "deviceId": { "type": "string" },
        "reason": { "type": "string" },
        "bannedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "bannedAt"]
    },
    "Flag": {
      "title": "Flag",
      "type": "object",
      "description": "Represents a flagged activity for manual review by admin.",
      "properties": {
        "ip": { "type": "string" },
        "deviceId": { "type": "string" },
        "flaggedAt": { "type": "string", "format": "date-time" },
        "clickCount": { "type": "number" },
        "reason": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["ip", "flaggedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/schools/{schoolId}",
        "definition": {
          "entityName": "School",
          "schema": { "$ref": "#/backend/entities/School" },
          "description": "Stores individual school data and scores."
        }
      },
      {
        "path": "/bans/{ip}",
        "definition": {
          "entityName": "Ban",
          "schema": { "$ref": "#/backend/entities/Ban" },
          "description": "Stores banned IP addresses."
        }
      },
      {
        "path": "/deviceBans/{deviceId}",
        "definition": {
          "entityName": "DeviceBan",
          "schema": { "$ref": "#/backend/entities/DeviceBan" },
          "description": "Stores banned Device IDs (browser-based UUIDs)."
        }
      },
      {
        "path": "/flags/{flagId}",
        "definition": {
          "entityName": "Flag",
          "schema": { "$ref": "#/backend/entities/Flag" },
          "description": "Stores flagged suspicious users for admin review."
        }
      }
    ]
  }
}
