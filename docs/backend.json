
{
  "entities": {
    "School": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "School",
      "type": "object",
      "description": "Represents a school participating in the 'School Click' application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number" },
        "daebakScore": { "type": "number" },
        "cityProvinceName": { "type": "string" },
        "schoolKind": { "type": "string" },
        "atptCode": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name", "score", "cityProvinceName", "schoolKind"]
    },
    "Ban": {
      "title": "Ban",
      "type": "object",
      "description": "Represents a banned IP address due to suspicious activity.",
      "properties": {
        "ip": { "type": "string" },
        "reason": { "type": "string" },
        "bannedAt": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      },
      "required": ["ip", "bannedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/schools/{schoolId}",
        "definition": {
          "entityName": "School",
          "schema": { "$ref": "#/backend/entities/School" },
          "description": "Stores individual school data and scores."
        }
      },
      {
        "path": "/bans/{ip}",
        "definition": {
          "entityName": "Ban",
          "schema": { "$ref": "#/backend/entities/Ban" },
          "description": "Stores banned IP addresses. Publicly readable to check ban status, but writable only when bot detection is triggered or by admin."
        }
      }
    ],
    "reasoning": "Using a separate /bans collection allows persistent IP-based blocking across sessions."
  }
}
